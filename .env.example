# HROne Attendance Bot Configuration
# Copy this file to .env and fill in your details

# ============================================
# CREDENTIALS (Required)
# ============================================

# Your HROne login email or mobile number
USERNAME=your.email@company.com

# Your HROne password
PASSWORD=your_password_here

# Company domain code (required)
# This is your company's identifier in HROne
# Usually your company's short name (e.g., "techcorp", "acme")
# You can find this in HROne API responses or by checking the network tab
DOMAIN_CODE=yourcompany


# ============================================
# SCHEDULE CONFIGURATION (Optional)
# ============================================
# Times in 24-hour format (HH:MM)
# Bot will pick a random time within each window
# Runs Monday to Friday only

# Morning punch window - randomly picks a time between START and END
# Default: 8:00 AM to 8:30 AM
MORNING_START=08:00
MORNING_END=08:30

# Evening punch window - randomly picks a time between START and END
# Default: 5:50 PM to 6:00 PM
EVENING_START=17:50
EVENING_END=18:00


# ============================================
# WEB DASHBOARD (Optional)
# ============================================

# Port for web dashboard (default: 3000)
WEB_PORT=3000

# Dashboard login credentials
# These are used to create the default admin user on first run
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

# Session secret (change this for production!)
SESSION_SECRET=your-secret-key-change-in-production


# ============================================
# NOTIFICATIONS (Optional)
# ============================================
# Get notified on Google Chat when attendance is marked
# Leave empty to disable notifications

# Google Chat Webhook URL
# To set up:
# 1. Open Google Chat → go to your Space
# 2. Click Space name → Apps & integrations → Manage webhooks
# 3. Click "Add another", name it (e.g., "Attendance Bot")
# 4. Copy the webhook URL and paste it below
GOOGLE_CHAT_WEBHOOK_URL=


# ============================================
# EXAMPLES
# ============================================
# Want to punch in between 9:15-9:45 AM and out between 6:00-6:15 PM?
# MORNING_START=09:15
# MORNING_END=09:45
# EVENING_START=18:00
# EVENING_END=18:15

# Want a wider morning window (8:00-9:00 AM)?
# MORNING_START=08:00
# MORNING_END=09:00
